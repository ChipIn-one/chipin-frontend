{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2023", "DOM"],
        "paths": {
            "constants/*": ["./src/constants/*"]
        }
    },
    "include": [
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.contract.config.ts",
        "pwa-assets.config.ts",
        "ds-gallery/vite.config.ts",
        "contract-tests/**/*.ts"
    ]
}
