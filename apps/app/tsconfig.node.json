{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2023", "DOM"],
        "paths": {
            "constants/*": ["./src/constants/*"]
        }
    },
    "include": [
        "vite.config.ts",
        "vite.config.test.ts",
        "pwa.config.ts",
        "pwa.config.test.ts",
        "vitest.config.ts",
        "vitest.contract.config.ts",
        "pwa-assets.config.ts",
        "contract-tests/**/*.ts",
        "playwright.config.ts",
        "playwright.sw.config.ts",
        "e2e/**/*.ts"
    ]
}
