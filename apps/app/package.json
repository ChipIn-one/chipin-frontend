{
    "name": "@chipin/app",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "test": "vitest",
        "test:task": "node scripts/run-task-tests.mjs",
        "test:full": "vitest run",
        "typecheck": "tsc -b",
        "vercel-build": "vite build",
        "preview": "vite preview",
        "icons:generate": "node scripts/generate-pwa-icons.mjs",
        "test:contract": "vitest run --config vitest.contract.config.ts",
        "test:contract:smoke": "vitest run --config vitest.contract.config.ts contract-tests/auth-session.contract.ts",
        "test:contract:full": "vitest run --config vitest.contract.config.ts contract-tests/core-api.contract.ts",
        "test:e2e": "playwright test",
        "test:e2e:sw": "playwright test -c playwright.sw.config.ts",
        "api:fetch": "node scripts/api/fetch-openapi.mjs",
        "api:fetch:staging": "node scripts/api/fetch-openapi.mjs --staging",
        "api:gen": "node scripts/api/gen-types.mjs && node scripts/offline/write-model-hash.mjs",
        "api:check": "npm run api:gen && node scripts/api/check-generated.mjs"
    },
    "dependencies": {
        "@chipin/i18n-content": "*",
        "@chipin/tokens": "*",
        "@radix-ui/themes": "^3.3.0",
        "@sentry/react": "^10.75.2",
        "@tanstack/query-async-storage-persister": "5.107.1",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-query-persist-client": "5.107.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.1.0",
        "axios": "^1.21.1",
        "i18next": "^26.7.2",
        "i18next-resources-to-backend": "1.2.4",
        "idb-keyval": "6.3.0",
        "lossless-json": "4.3.3",
        "lucide-react": "^1.73.0",
        "qrcode-generator": "^2.0.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "react-router-dom": "^7.18.5",
        "sonner": "^2.0.8",
        "styled-components": "^6.6.0",
        "zod": "4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "1.65.1",
        "@sentry/vite-plugin": "^5.4.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vercel/routing-utils": "^6.6.1",
        "@vite-pwa/assets-generator": "^1.0.4",
        "@vitejs/plugin-react": "^6.3.0",
        "fake-indexeddb": "6.2.8",
        "jsdom": "^30.1.3",
        "msw": "2.15.0",
        "openapi-typescript": "7.13.0",
        "typescript": "~5.9.3",
        "vite": "^8.3.8",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-svgr": "^4.5.0",
        "vitest": "^5.1.0",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": "24.x"
    }
}
