{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run vercel-build",
    "installCommand": "cd ../.. && npm ci",
    "git": {
        "deploymentEnabled": {
            "dev": false,
            "main": false
        }
    },
    "redirects": [
        {
            "source": "/:locale(es|pt-br|pt-pt|pt-BR|pt-PT){/:path([^/\\\\\\t\\n\\r].*?)}?{/}?",
            "destination": "/:path",
            "statusCode": 301
        },
        {
            "source": "/:path((?:dashboard|solo|activity|settings|group|friends|oauth)(?:/.*)?|not-found)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "https://app.chipin.one/:path",
            "statusCode": 302
        },
        {
            "source": "/app.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "https://app.chipin.one/",
            "statusCode": 302
        },
        {
            "source": "/index.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "/",
            "statusCode": 302
        },
        {
            "source": "/:path([^/\\\\\\t\\n\\r].*?)/index.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "/:path",
            "statusCode": 302
        },
        {
            "source": "/manifest.webmanifest",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "/legacy-host-has-no-manifest",
            "statusCode": 302
        },
        {
            "source": "/:path((?:dashboard|solo|activity|settings|group|friends|oauth)(?:/.*)?|not-found)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "https://app-dev.chipin.one/:path",
            "statusCode": 302
        },
        {
            "source": "/app.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "https://app-dev.chipin.one/",
            "statusCode": 302
        },
        {
            "source": "/index.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "/",
            "statusCode": 302
        },
        {
            "source": "/:path([^/\\\\\\t\\n\\r].*?)/index.html",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "/:path",
            "statusCode": 302
        },
        {
            "source": "/manifest.webmanifest",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "/legacy-host-has-no-manifest",
            "statusCode": 302
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "https://api.chipin.one/:path*"
        },
        {
            "source": "/api/:path*",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "https://api-dev.chipin.one/:path*"
        },
        {
            "source": "/api/:path*",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app.chipin.one"
                    }
                }
            ],
            "destination": "https://api.chipin.one/:path*"
        },
        {
            "source": "/api/:path*",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app-dev.chipin.one"
                    }
                }
            ],
            "destination": "https://api-dev.chipin.one/:path*"
        },
        {
            "source": "/api/:path*",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "suf": ".vercel.app"
                    }
                }
            ],
            "destination": "https://api-dev.chipin.one/:path*"
        },
        {
            "source": "/sw.js",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "/sw-kill.js"
        },
        {
            "source": "/sw.js",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "/sw-kill.js"
        },
        {
            "source": "/sw.js",
            "destination": "/sw-app.js"
        },
        {
            "source": "/.well-known/assetlinks.json",
            "destination": "/.well-known/assetlinks.json"
        },
        {
            "source": "/dashboard/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/solo/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/group/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/activity/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/friends/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/settings/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/oauth/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/not-found",
            "destination": "/app.html"
        },
        {
            "source": "/((?!api/|assets/|_vercel/|\\.well-known/)(?!.*\\.[^/]+$).*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app.chipin.one"
                    }
                }
            ],
            "destination": "/app.html"
        },
        {
            "source": "/((?!api/|assets/|_vercel/|\\.well-known/)(?!.*\\.[^/]+$).*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app-dev.chipin.one"
                    }
                }
            ],
            "destination": "/app.html"
        },
        {
            "source": "/((?!api/|assets/|_vercel/|\\.well-known/)(?!.*\\.[^/]+$).*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "suf": ".vercel.app"
                    }
                }
            ],
            "destination": "/app.html"
        }
    ],
    "headers": [
        {
            "source": "/api/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "private, no-store, max-age=0"
                },
                {
                    "key": "CDN-Cache-Control",
                    "value": "no-store"
                },
                {
                    "key": "Vercel-CDN-Cache-Control",
                    "value": "no-store"
                },
                {
                    "key": "X-Vercel-Enable-Rewrite-Caching",
                    "value": "0"
                }
            ]
        },
        {
            "source": "/.well-known/assetlinks.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; img-src 'self' data: blob: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; manifest-src 'self'; worker-src 'self' blob:; connect-src 'self' https://*.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/manifest+json"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app.chipin.one"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "app-dev.chipin.one"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "suf": ".vercel.app"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ]
}
