{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "astro",
    "installCommand": "cd ../.. && npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "redirects": [
        {
            "source": "/group/join/:token",
            "destination": "/join/group/:token",
            "statusCode": 302
        },
        {
            "source": "/friends/join/:token",
            "destination": "/join/friend/:token",
            "statusCode": 302
        },
        {
            "source": "/:path((?:dashboard|solo|activity|settings|group|friends|oauth|login)(?:/.*)?)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "chipin.one"
                    }
                }
            ],
            "destination": "https://app.chipin.one/:path",
            "statusCode": 302
        },
        {
            "source": "/:path((?:dashboard|solo|activity|settings|group|friends|oauth|login)(?:/.*)?)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "destination": "https://app-dev.chipin.one/:path",
            "statusCode": 302
        },
        {
            "source": "/:path((?:dashboard|solo|activity|settings|group|friends|oauth|login)(?:/.*)?)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "site-dev.chipin.one"
                    }
                }
            ],
            "destination": "https://app-dev.chipin.one/:path",
            "statusCode": 302
        },
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap-index.xml",
            "statusCode": 302
        },
        {
            "source": "/index.html",
            "destination": "/",
            "statusCode": 302
        },
        {
            "source": "/app.html",
            "destination": "/",
            "statusCode": 302
        },
        {
            "source": "/:path([^/\\\\].*?)/index.html",
            "destination": "/:path",
            "statusCode": 302
        },
        {
            "source": "/:locale(es|pt-br|pt-pt|pt-BR|pt-PT){/:path([^/\\\\].*?)}?{/}?",
            "destination": "/:path",
            "statusCode": 301
        },
        {
            "source": "/privacy/",
            "destination": "/privacy",
            "statusCode": 301
        },
        {
            "source": "/terms/",
            "destination": "/terms",
            "statusCode": 301
        },
        {
            "source": "/ru",
            "destination": "/ru/",
            "statusCode": 301
        },
        {
            "source": "/ru/privacy/",
            "destination": "/ru/privacy",
            "statusCode": 301
        },
        {
            "source": "/ru/terms/",
            "destination": "/ru/terms",
            "statusCode": 301
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "site-dev.chipin.one"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "eq": "dev.chipin.one"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": {
                        "suf": ".vercel.app"
                    }
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ]
}
