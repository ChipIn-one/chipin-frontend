---
import faviconUrl from '@chipin/tokens/assets/favicon.svg?url';
import { THEME_INIT_SCRIPT } from '@chipin/tokens/theme-init';

import LanguageLinks from '../components/LanguageLinks.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
    DEFAULT_LOCALE,
    localizedPath,
    SUPPORTED_LOCALES,
    type SupportedLocale,
} from '../i18n/locales';
import { messages } from '../i18n/ui';
import { ANALYTICS_REDACT_SCRIPT } from '../lib/analyticsRedact';
import { resolveAppOrigin } from '../lib/appOrigin';
import { homeStructuredData, serializeJsonLd } from '../lib/structuredData';

import '@chipin/tokens/radix-colors.css';
import '@chipin/tokens/tokens.css';

interface Props {
    locale: SupportedLocale;
    title: string;
    description: string;
    /**
     * The page slug without the locale (`''` = home). `null` for pages without a canonical URL
     * (404): no canonical, no hreflang, no og:url.
     */
    slug: string | null;
    /** Locales that have a translation of this page; a missing one gets no hreflang (§3.3). */
    translations?: readonly SupportedLocale[];
    noindex?: boolean;
    /**
     * `false` leaves out Web Analytics and Speed Insights: invite pages carry the token in the URL
     * (spec 04 §3.6, KB USR-084).
     */
    includeAnalytics?: boolean;
    /** `no-referrer` for invite pages, on top of the vercel.json header (KB USR-085). */
    referrer?: 'no-referrer';
    /** The home page: full-width sections and the header anchors to them. */
    landing?: boolean;
    /**
     * `minimal` keeps only the language links (the invite landing): no "Open ChipIn" to `/login`
     * that would lose the invite, no footer in one fixed language (KB USR-081, USR-083).
     */
    chrome?: 'full' | 'minimal';
}

const {
    locale,
    title,
    description,
    slug,
    translations = SUPPORTED_LOCALES,
    noindex = false,
    includeAnalytics = true,
    referrer,
    landing = false,
    chrome = 'full',
} = Astro.props;

const appOrigin = resolveAppOrigin({
    value: import.meta.env.PUBLIC_APP_ORIGIN,
    onVercel: process.env.VERCEL === '1',
});

// `site` is always https://chipin.one: dev hosts never reach canonical or hreflang (§3.2).
const site = Astro.site ?? new URL('https://chipin.one');
const absolute = (target: SupportedLocale, page: string): string =>
    new URL(localizedPath(target, page), site).href;
const canonical = slug === null ? null : absolute(locale, slug);
const alternates =
    slug === null
        ? []
        : translations.map(target => ({ hreflang: target, href: absolute(target, slug) }));
// One social preview for every page, absolute on `site` (#940); source: src/assets/og-image.svg.
const ogImage = new URL('/og-image.png', site).href;
const ogImageAlt = messages(locale).meta.ogImageAlt;
// #941: the JSON-LD only on the locale home pages (`/`, `/ru/`). A data block the browser does
// not execute: the CSP script-src does not apply to it, so it needs no hash (seoGuard).
const structuredData =
    landing && slug === '' ? serializeJsonLd(homeStructuredData({ locale, site })) : null;
const xDefault =
    slug !== null && translations.includes(DEFAULT_LOCALE) ? absolute(DEFAULT_LOCALE, slug) : null;
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <!-- First, before any CSS: sets html.light|dark (spec 04 §3.6, spec 05 PR 05-3). -->
        <script is:inline set:html={THEME_INIT_SCRIPT} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" href={faviconUrl} type="image/svg+xml" />
        {noindex && <meta name="robots" content="noindex" />}
        {referrer && <meta name="referrer" content={referrer} />}
        {canonical && <link rel="canonical" href={canonical} />}
        {alternates.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
        {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="ChipIn" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content={messages(locale).meta.ogLocale} />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        {
            structuredData && (
                <script is:inline type="application/ld+json" set:html={structuredData} />
            )
        }
        <!-- Before the analytics scripts: redacts invite tokens from reported URLs (§3.6). -->
        <script is:inline set:html={ANALYTICS_REDACT_SCRIPT} />
        {
            includeAnalytics && (
                <>
                    <script is:inline defer src="/_vercel/insights/script.js" />
                    <script is:inline defer src="/_vercel/speed-insights/script.js" />
                </>
            )
        }
    </head>
    <body>
        {
            chrome === 'minimal' ? (
                <header class="minimal-header">
                    <LanguageLinks current={locale} slug={slug ?? ''} locales={translations} />
                </header>
            ) : (
                <SiteHeader
                    locale={locale}
                    slug={slug ?? ''}
                    locales={translations}
                    appOrigin={appOrigin}
                    landingNav={landing}
                />
            )
        }
        <main class:list={[landing ? 'landing' : 'page']}>
            <slot />
        </main>
        {chrome === 'full' && <SiteFooter locale={locale} />}
    </body>
</html>

<style is:global>
    body {
        margin: 0;
        background: var(--cp-surface-base);
        color: var(--cp-text-primary);
        font-family: var(--cp-font-sans);
        line-height: 1.5;
    }
</style>

<style>
    .minimal-header {
        display: flex;
        justify-content: flex-end;
        padding: 1rem;
    }

    .page {
        max-width: 48rem;
        margin: 0 auto;
        padding: 1rem;
    }

    .landing {
        padding: 0 var(--cp-space-4);
    }
</style>
