---
import { localizedPath, SUPPORTED_LOCALES, type SupportedLocale } from '../i18n/locales';
import { messages } from '../i18n/ui';

interface Props {
    current: SupportedLocale;
    /** The page slug (`''` = home); only `locales` that have this page are linked. */
    slug: string;
    locales?: readonly SupportedLocale[];
}

const { current, slug, locales = SUPPORTED_LOCALES } = Astro.props;
---

<nav class="language-links">
    <ul>
        {
            locales.map(locale => (
                <li>
                    <a
                        href={localizedPath(locale, slug)}
                        hreflang={locale}
                        lang={locale}
                        aria-current={locale === current ? 'page' : undefined}
                    >
                        {messages(locale).meta.languageName}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .language-links ul {
        display: flex;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .language-links a[aria-current='page'] {
        font-weight: 600;
        text-decoration: none;
    }
</style>
