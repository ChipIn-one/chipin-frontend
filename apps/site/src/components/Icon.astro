---
import { type IconName, ICONS } from '../lib/icons';

// A lucide icon as inline SVG (lib/icons.ts). Decorative unless it gets a `label`.
interface Props {
    name: IconName;
    size?: number;
    label?: string;
    class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    class:list={['icon', className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    role={label === undefined ? undefined : 'img'}
    aria-label={label}
    aria-hidden={label === undefined ? 'true' : undefined}
    set:html={ICONS[name]}
/>

<style>
    .icon {
        flex-shrink: 0;
    }
</style>
