---
import type { SupportedLocale } from '../../i18n/locales';
import { messages } from '../../i18n/ui';
import Icon from '../Icon.astro';

import GroupPreview from './GroupPreview.astro';

// The app showcase-sections: the group expenses showcase with its page preview (the app renders
// only this one; the solo showcase texts are not rendered there either).
interface Props {
    locale: SupportedLocale;
}

const { locale } = Astro.props;
const { groups } = messages(locale).landing.sections;
const bullets = [
    groups.bullets.shareableLink,
    groups.bullets.realTimeBalances,
    groups.bullets.debtSimplification,
    groups.bullets.multiCurrency,
];
---

<section class="showcase">
    <div class="content">
        <span class="badge">
            <Icon name="users" size={14} />
            {groups.badge}
        </span>
        <h2>
            {groups.titlePart1}{' '}
            <span class="highlight">{groups.titleHighlight}</span>
        </h2>
        <p class="description">{groups.description}</p>
        <ul class="bullets">
            {
                bullets.map(bullet => (
                    <li>
                        <span class="check">
                            <Icon name="checkCircle" size={18} />
                        </span>
                        {bullet}
                    </li>
                ))
            }
        </ul>
    </div>
    <GroupPreview locale={locale} />
</section>

<style>
    .showcase {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--cp-space-9);
        align-items: center;
        max-width: 1136px;
        margin: 0 auto;
        padding: var(--cp-space-8) 0;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: var(--cp-space-4);
    }

    .badge {
        display: inline-flex;
        gap: var(--cp-space-1);
        align-items: center;
        width: max-content;
        padding: var(--cp-space-1) var(--cp-space-3);
        border: 1px solid var(--green-a6);
        border-radius: var(--cp-radius-pill);
        background: var(--green-a2);
        color: var(--green-a11);
        font-size: var(--cp-font-size-2);
        font-weight: var(--cp-font-weight-medium);
    }

    h2 {
        margin: 0;
        font-size: var(--cp-font-size-7);
        line-height: 1.2;
    }

    .highlight {
        color: var(--green-11);
    }

    .description {
        margin: 0;
        color: var(--cp-text-secondary);
        font-size: var(--cp-font-size-4);
    }

    .bullets {
        display: flex;
        flex-direction: column;
        gap: var(--cp-space-3);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .bullets li {
        display: flex;
        gap: var(--cp-space-3);
        align-items: center;
    }

    .check {
        display: inline-flex;
        color: var(--green-11);
    }

    @media (min-width: 1024px) {
        .showcase {
            grid-template-columns: repeat(2, 1fr);
        }

        h2 {
            font-size: var(--cp-font-size-9);
        }
    }
</style>
