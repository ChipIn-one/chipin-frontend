{
    "name": "chipin-frontend",
    "private": true,
    "version": "1.0.10",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && npm run verify:public-precache",
        "lint": "node scripts/check-rule-registry.mjs && eslint . --max-warnings 0",
        "lint:full": "node scripts/check-rule-registry.mjs && CHIPIN_ESLINT_FULL=1 eslint . --max-warnings 0",
        "baseline:update": "eslint . --prune-suppressions",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:task": "node scripts/run-task-tests.mjs",
        "test:full": "vitest run",
        "typecheck": "tsc -b",
        "verify": "npm run format:check && npm run lint && npm run typecheck",
        "verify:full": "npm run format:check && npm run lint:full && npm run test:full && npm run build && npm run build:ds-gallery",
        "vercel-build": "vite build && npm run verify:public-precache",
        "prepare": "husky",
        "pr:create": "node scripts/create-pr.mjs",
        "version:bump": "node scripts/version-bump.mjs",
        "version:check": "node scripts/version-check.mjs",
        "preview": "vite preview",
        "icons:generate": "pwa-assets-generator",
        "test:contract": "vitest run --config vitest.contract.config.ts",
        "test:contract:smoke": "vitest run --config vitest.contract.config.ts contract-tests/auth-session.contract.ts",
        "test:contract:full": "vitest run --config vitest.contract.config.ts contract-tests/core-api.contract.ts",
        "prerender:public": "node scripts/prerender-public.mjs",
        "verify:public-precache": "node scripts/verify-public-precache.mjs",
        "build:ds-gallery": "vite build --config ds-gallery/vite.config.ts && node ds-gallery/build-html.mjs"
    },
    "dependencies": {
        "@radix-ui/themes": "^3.3.0",
        "@sentry/react": "^10.75.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.21.0",
        "i18next": "^26.5.11",
        "lucide-react": "^1.62.0",
        "next-themes": "^0.4.6",
        "qrcode-generator": "^2.0.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "react-router-dom": "^7.18.4",
        "sonner": "^2.0.8",
        "styled-components": "^6.6.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@sentry/vite-plugin": "^5.4.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-svgr": "^4.5.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    },
    "allowScripts": {
        "@sentry/cli": true,
        "@swc/core": true,
        "fsevents": false,
        "sharp": false
    },
    "engines": {
        "node": "24.x"
    }
}
