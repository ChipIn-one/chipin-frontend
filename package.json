{
    "name": "chipin-frontend",
    "private": true,
    "version": "0.12.3",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run create-pwa-icons && tsc -b && vite build",
        "lint": "eslint .",
        "test": "vitest",
        "test:run": "vitest run",
        "test:task": "node scripts/run-task-tests.mjs",
        "test:full": "vitest run",
        "typecheck": "tsc -b",
        "verify": "npm run lint -- --quiet && npm run typecheck",
        "verify:full": "npm run lint && npm run test:full && npm run build",
        "vercel-build": "npm run create-pwa-icons && vite build",
        "prepare": "husky",
        "pr:create": "node scripts/create-pr.mjs",
        "version:bump": "node scripts/version-bump.mjs",
        "version:check": "node scripts/version-check.mjs",
        "preview": "vite preview",
        "create-pwa-icons": "pwa-assets-generator",
        "test:contract": "vitest run --config vitest.contract.config.ts",
        "test:contract:smoke": "vitest run --config vitest.contract.config.ts contract-tests/auth-session.contract.ts",
        "test:contract:full": "vitest run --config vitest.contract.config.ts contract-tests/core-api.contract.ts"
    },
    "dependencies": {
        "@radix-ui/themes": "^3.3.0",
        "@sentry/react": "^10.75.0",
        "@uidotdev/usehooks": "^2.4.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.20.0",
        "dexie": "^4.4.6",
        "dexie-react-hooks": "^4.2.0",
        "i18next": "^26.4.2",
        "lucide-react": "^1.46.0",
        "next-themes": "^0.4.6",
        "qrcode-generator": "^2.0.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.14",
        "react-router-dom": "^7.18.4",
        "sonner": "^2.0.8",
        "styled-components": "^6.5.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@sentry/vite-plugin": "^5.4.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "sharp": "^0.35.4",
        "sharp-ico": "^0.1.5",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-svgr": "^4.5.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.10",
        "workbox-core": "^7.3.0",
        "workbox-window": "^7.3.0",
        "yaml": "^2.9.1"
    },
    "overrides": {
        "@vite-pwa/assets-generator": {
            "sharp": "0.35.3"
        }
    },
    "engines": {
        "node": "24.21.0"
    }
}
