{
    "name": "chipin-frontend",
    "private": true,
    "version": "1.0.10",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @chipin/app --",
        "build": "npm run build -w @chipin/app --",
        "lint": "node scripts/check-rule-registry.mjs && node scripts/check-styled-allowlist.mjs && npm run lint:css && npm run sync:site && eslint . --max-warnings 0 --pass-on-unpruned-suppressions",
        "lint:full": "node scripts/check-rule-registry.mjs && node scripts/check-styled-allowlist.mjs && npm run lint:css && npm run sync:site && CHIPIN_ESLINT_FULL=1 eslint . --max-warnings 0",
        "lint:css": "stylelint 'apps/*/**/*.css' 'apps/*/**/*.astro' --max-warnings 0",
        "baseline:update": "npm run sync:site && CHIPIN_ESLINT_FULL=1 eslint . --prune-suppressions",
        "sync:site": "npm run sync -w @chipin/site",
        "fix": "npm run sync:site && eslint . --fix; prettier --write .",
        "layers:doc": "node scripts/generate-layers-doc.mjs",
        "check:file-layout": "node scripts/check-file-layout.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run test -w @chipin/app --",
        "test:task": "npm run test:task -w @chipin/app --",
        "test:full": "npm run test:full -w @chipin/app && npm run test:repo",
        "typecheck": "npm run typecheck -w @chipin/app && npm run typecheck:packages",
        "typecheck:packages": "npm run typecheck -w packages",
        "verify": "npm run format:check && npm run lint && npm run check:file-layout && npm run typecheck",
        "verify:full": "npm run format:check && npm run lint:full && npm run check:file-layout && npm run typecheck:packages && npm run test:full && npm run build",
        "vercel-build": "npm run vercel-build -w @chipin/app --",
        "prepare": "husky",
        "pr:create": "node scripts/create-pr.mjs",
        "preview": "npm run preview -w @chipin/app --",
        "icons:generate": "npm run icons:generate -w @chipin/app --",
        "test:contract": "npm run test:contract -w @chipin/app --",
        "test:contract:smoke": "npm run test:contract:smoke -w @chipin/app --",
        "test:contract:full": "npm run test:contract:full -w @chipin/app --",
        "test:e2e": "npm run test:e2e -w @chipin/app --",
        "test:e2e:sw": "npm run test:e2e:sw -w @chipin/app --",
        "api:fetch": "npm run api:fetch -w @chipin/app --",
        "api:fetch:staging": "npm run api:fetch:staging -w @chipin/app --",
        "api:gen": "npm run api:gen -w @chipin/app --",
        "api:check": "npm run api:check -w @chipin/app --",
        "test:repo": "vitest run"
    },
    "lint-staged": {
        "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
            "node scripts/eslint-fix-staged.mjs",
            "prettier --write"
        ],
        "*.astro": [
            "node scripts/eslint-fix-staged.mjs"
        ],
        "*.{json,md,css,scss,yml,yaml,html}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tanstack/eslint-plugin-query": "5.108.4",
        "@types/node": "^24.19.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-boundaries": "^7.4.4",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "postcss-html": "^2.0.1",
        "prettier": "^3.10.1",
        "stylelint": "^18.1.0",
        "stylelint-value-no-unknown-custom-properties": "^6.1.1",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.1",
        "yaml": "^2.9.1"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        },
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "workbox-build": {
            "glob": "^14.0.3"
        },
        "@sentry/bundler-plugins": {
            "glob": "^14.0.3"
        },
        "@vercel/routing-utils": {
            "path-to-regexp": "6.3.0"
        },
        "eslint-plugin-import-x": {
            "minimatch": "^11.0.1"
        }
    },
    "allowScripts": {
        "@sentry/cli": true,
        "fsevents": false,
        "msw": false,
        "sharp": false
    },
    "engines": {
        "node": "24.x"
    }
}
