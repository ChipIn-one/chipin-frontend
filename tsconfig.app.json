{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        // No ambient @types: browser code must not see the Node globals of @types/node.
        "types": [],

        // Aliases: the only list. ESLint (config/eslint/aliases.js) and Vite (vite-tsconfig-paths) read it.
        "paths": {
            "main": ["./src/main.tsx"],
            "bootstrap/*": ["./src/bootstrap/*"],
            "pages/*": ["./src/pages/*"],
            "features/*": ["./src/features/*"],
            "store/*": ["./src/store/*"],
            "api/*": ["./src/api/*"],
            "hooks/*": ["./src/hooks/*"],
            "helpers/*": ["./src/helpers/*"],
            "constants/*": ["./src/constants/*"],
            "i18n": ["./src/i18n"],
            "i18n/*": ["./src/i18n/*"],
            "types/*": ["./src/types/*"],
            "public-routes": ["./src/public-routes"],
            "public-routes/*": ["./src/public-routes/*"],
            "test/*": ["./src/test/*"],
            "components/*": ["./src/components/*"],
            "basics": ["./src/basics"],
            "basics/*": ["./src/basics/*"],
            "assets/*": ["./src/assets/*"],
            "styles/*": ["./src/styles/*"]
        }
    },
    "include": ["src", "ds-gallery"],
    "exclude": ["ds-gallery/vite.config.ts"]
}
