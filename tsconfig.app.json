{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        // Types add
        "typeRoots": ["./node_modules/@types"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,

        // Aliases: the only list. ESLint (config/eslint/aliases.js) and Vite (vite-tsconfig-paths) read it.
        "paths": {
            "main": ["./src/main.tsx"],
            "bootstrap": ["./src/bootstrap"],
            "bootstrap/*": ["./src/bootstrap/*"],
            "pages": ["./src/pages"],
            "pages/*": ["./src/pages/*"],
            "features": ["./src/features"],
            "features/*": ["./src/features/*"],
            "store": ["./src/store"],
            "store/*": ["./src/store/*"],
            "api": ["./src/api"],
            "api/*": ["./src/api/*"],
            "hooks": ["./src/hooks"],
            "hooks/*": ["./src/hooks/*"],
            "helpers": ["./src/helpers"],
            "helpers/*": ["./src/helpers/*"],
            "constants": ["./src/constants"],
            "constants/*": ["./src/constants/*"],
            "i18n": ["./src/i18n"],
            "i18n/*": ["./src/i18n/*"],
            "types": ["./src/types"],
            "types/*": ["./src/types/*"],
            "public-routes": ["./src/public-routes"],
            "public-routes/*": ["./src/public-routes/*"],
            "test": ["./src/test"],
            "test/*": ["./src/test/*"],
            "components": ["./src/components"],
            "components/*": ["./src/components/*"],
            "basics": ["./src/basics"],
            "basics/*": ["./src/basics/*"],
            "assets": ["./src/assets"],
            "assets/*": ["./src/assets/*"],
            "styles": ["./src/styles"],
            "styles/*": ["./src/styles/*"]
        }
    },
    "include": ["src"]
}
